<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_proceso_control"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_medium"
    android:layout_marginEnd="@dimen/spacing_medium"
    android:layout_marginTop="@dimen/spacing_large"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    android:background="@color/gray_300">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_large"
        android:background="@color/gray_300"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:text="Control de Proceso del Biodigestor"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_proceso_estado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            android:text="Estado: Pendiente de verificar..."
            android:textColor="@color/gray_700"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_iniciar_proceso"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Iniciar Proceso"
                android:textSize="12sp"
                android:layout_marginEnd="@dimen/spacing_medium"
                app:icon="@drawable/ic_play"
                android:enabled="false"

                app:backgroundTint="@color/btn_start_tint"
                app:iconTint="@color/white"
                android:textColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finalizar_proceso"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Finalizar Proceso"
                android:textSize="12sp"
                app:icon="@drawable/ic_stop"
                android:enabled="false"

                app:backgroundTint="@color/btn_finalizar_tint"
                app:iconTint="@color/white"
                android:textColor="@color/white" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/proceso_progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="@dimen/spacing_medium" />

    </LinearLayout>
</androidx.cardview.widget.CardView>